# PostgreSQL database connection URL
DATABASE_URL=postgresql://harness:harness@127.0.0.1:5432/harness

# LLM Provider configuration
# Supported providers: openai, anthropic, google, openrouter
PROVIDER_NAME=openai
MODEL_NAME=gpt-4o-mini
MODEL_API_KEY=your-api-key-here
# Optional OpenAI-compatible endpoint (for example, a local 9router instance)
# MODEL_BASE_URL=http://127.0.0.1:20128/v1

# Provider request and cost profile
MODEL_TIMEOUT_MS=30000
MODEL_MAX_OUTPUT_TOKENS=4096
# Required for production multi-turn context preflight; use the provider/model's evidenced hard input limit.
# MODEL_MAX_CONTEXT_TOKENS=32768
MODEL_OUTPUT_TOKENS_FIELD=max_tokens
# Set both explicit rates to price a model absent from the registry (USD per million tokens)
# MODEL_INPUT_COST_PER_MTOK=1.0
# MODEL_OUTPUT_COST_PER_MTOK=3.0

# Optional immutable source snapshot storage and run budgets
# HARNESS_SNAPSHOT_DIR=./data/snapshots
# HARNESS_MAX_STEPS=10
# HARNESS_MAX_TOOL_CALLS=20
# HARNESS_MAX_TOTAL_TOKENS=200000
# HARNESS_MAX_COST_USD=5
