# ==============================================
# Audit Harness API — Environment Configuration
# ==============================================
# Copy file này thành .env và điền các giá trị thực tế.
# KHÔNG commit file .env vào git (đã có trong .gitignore).

# --- Database ---
# SQLite: file:./dev.db (relative đến thư mục apps/api)
# Prisma sẽ tự tạo file nếu chưa tồn tại khi chạy `prisma db push`
DATABASE_URL="file:./dev.db"

# --- Server ---
PORT=3000

# --- Prompt Version ---
# Dùng để tracking config trong configSnapshot
PROMPT_VERSION="v1.0.0"

# --- Optional: API Key cho production ---
# API_KEY="your-secret-key-here"
