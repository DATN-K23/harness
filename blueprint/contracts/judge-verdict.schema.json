{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.local/schemas/judge-verdict-v1.json",
  "title": "Judge Verdict v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "validity",
    "severity",
    "confidence",
    "rationale",
    "evidence",
    "verification_status",
    "label_normalization_version"
  ],
  "properties": {
    "schema_version": { "const": "judge-verdict-v1" },
    "validity": { "enum": ["valid", "invalid"] },
    "severity": { "enum": ["none", "low", "medium", "high", "critical"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "rationale": { "type": "string", "minLength": 1, "maxLength": 12000 },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": { "$ref": "#/$defs/evidence" }
    },
    "verification_status": { "$ref": "#/$defs/verification_status" },
    "label_normalization_version": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    }
  },
  "oneOf": [
    {
      "properties": {
        "validity": { "const": "valid" },
        "severity": { "enum": ["low", "medium", "high", "critical"] }
      }
    },
    {
      "properties": {
        "validity": { "const": "invalid" },
        "severity": { "const": "none" }
      }
    }
  ],
  "$defs": {
    "verification_status": {
      "type": "string",
      "const": "unverified",
      "description": "Judge MVP reasoning and source evidence have not been verified by executable PoC."
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "start_line", "end_line", "content_digest"],
      "properties": {
        "path": { "$ref": "#/$defs/relative_path" },
        "start_line": { "type": "integer", "minimum": 1 },
        "end_line": { "type": "integer", "minimum": 1 },
        "content_digest": { "$ref": "#/$defs/digest" },
        "note": { "type": "string", "maxLength": 2000 }
      }
    }
  }
}
