{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.local/schemas/trajectory-events-v1.json",
  "title": "Judge Trajectory Event List v1",
  "type": "array",
  "minItems": 1,
  "items": { "$ref": "#/$defs/event" },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "money": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "currency"],
      "properties": {
        "amount": { "type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$" },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "total_tokens"],
      "properties": {
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "cached_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "reasoning_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "total_tokens": { "type": "integer", "minimum": 0 }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "event_id", "run_id", "sequence", "type", "occurred_at", "payload"],
      "properties": {
        "schema_version": { "const": "trajectory-event-v1" },
        "event_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "run_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "sequence": { "type": "integer", "minimum": 1 },
        "type": {
          "enum": [
            "run.accepted", "run.queued", "run.started", "context.allocated",
            "context.transformed", "provider.attempted", "provider.failed",
            "model.responded", "tool.requested", "tool.completed", "tool.failed",
            "security.blocked", "verdict.validation_failed", "run.cancel_requested",
            "run.completed", "run.failed", "run.cancelled", "run.budget_exhausted"
          ]
        },
        "occurred_at": { "type": "string", "format": "date-time" },
        "payload": {
          "type": "object",
          "propertyNames": {
            "not": {
              "pattern": "^(selected_path|raw_path|raw_host_path|host_path|source_root|authorized_root_ref|credential|ground_truth_label)$"
            }
          },
          "description": "Safe payload. The canonical event gate applies this forbidden-name rule recursively before persistence and projection."
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "context.allocated" } } },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "required": ["context_limit", "output_reserve", "bucket_tokens", "estimator_version", "provider_call_allowed"],
                "properties": {
                  "context_limit": { "type": "integer", "minimum": 1 },
                  "output_reserve": { "type": "integer", "minimum": 1 },
                  "bucket_tokens": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
                  "estimator_version": { "type": "string", "minLength": 1 },
                  "provider_call_allowed": { "type": "boolean" }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "provider.attempted" } } },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "required": ["attempt_index", "provider_profile", "model_id", "request_digest", "latency_ms", "usage", "cost", "pricing_version"],
                "properties": {
                  "attempt_index": { "type": "integer", "minimum": 1 },
                  "provider_profile": { "type": "string", "minLength": 1 },
                  "model_id": { "type": "string", "minLength": 1 },
                  "request_digest": { "$ref": "#/$defs/digest" },
                  "latency_ms": { "type": "integer", "minimum": 0 },
                  "usage": { "$ref": "#/$defs/usage" },
                  "cost": { "$ref": "#/$defs/money" },
                  "pricing_version": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "enum": ["tool.requested", "tool.completed", "tool.failed"] } } },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "required": ["tool_call_id", "tool_name", "tool_version"],
                "properties": {
                  "tool_call_id": { "type": "string", "minLength": 1 },
                  "tool_name": { "type": "string", "minLength": 1 },
                  "tool_version": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "security.blocked" } } },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "required": ["rule_id", "safe_category", "safe_message"],
                "properties": {
                  "rule_id": { "type": "string", "minLength": 1 },
                  "safe_category": { "type": "string", "minLength": 1 },
                  "safe_message": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "enum": ["run.completed", "run.failed", "run.cancelled", "run.budget_exhausted"] } } },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "required": ["terminal_state"],
                "properties": {
                  "terminal_state": { "enum": ["completed", "failed", "cancelled", "budget_exhausted"] },
                  "terminal_reason": { "type": ["string", "null"] }
                }
              }
            }
          }
        }
      ]
    }
  }
}
