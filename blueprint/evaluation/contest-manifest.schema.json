{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.local/schemas/contest-manifest-v2.json",
  "title": "Contest and source-family evaluation manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "version", "frozen", "created_at", "label_normalization_version", "split_policy_version", "provenance", "source_families", "contests", "content_digest"],
  "properties": {
    "schema_version": {"const": "contest-manifest-v2"},
    "manifest_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "version": {"type": "string", "minLength": 1, "maxLength": 128},
    "frozen": {"const": true},
    "created_at": {"type": "string", "format": "date-time"},
    "label_normalization_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "split_policy_version": {"const": "whole-contest+source-family-v1"},
    "provenance": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["platform", "source_reference", "retrieved_at"],
        "properties": {
          "platform": {"enum": ["code4rena", "sherlock", "codehawks", "synthetic"]},
          "source_reference": {"type": "string", "minLength": 1, "maxLength": 2048},
          "retrieved_at": {"type": "string", "format": "date-time"}
        }
      }
    },
    "source_families": {
      "type": "object", "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"},
      "additionalProperties": {"$ref": "#/$defs/sourceFamily"}
    },
    "contests": {
      "type": "object", "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"},
      "additionalProperties": {"$ref": "#/$defs/contest"}
    },
    "content_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "split": {"enum": ["train", "validation", "test"]},
    "sourceFamily": {
      "type": "object", "additionalProperties": false,
      "required": ["split", "basis", "contest_ids"],
      "properties": {
        "split": {"$ref": "#/$defs/split"},
        "basis": {"type": "string", "minLength": 1, "maxLength": 512},
        "contest_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}}
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["source_snapshot_id", "revision", "source_tree_digest"],
      "properties": {
        "source_snapshot_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "revision": {"type": "string", "minLength": 1, "maxLength": 256},
        "source_tree_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "contamination": {
      "type": "object", "additionalProperties": false,
      "required": ["model_id", "knowledge_cutoff", "bucket", "evidence_reference"],
      "properties": {
        "model_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "knowledge_cutoff": {"type": ["string", "null"], "format": "date-time"},
        "bucket": {"enum": ["pre_cutoff", "post_cutoff", "unknown"]},
        "evidence_reference": {"type": "string", "minLength": 1, "maxLength": 2048}
      },
      "oneOf": [
        {"properties": {"knowledge_cutoff": {"type": "null"}, "bucket": {"const": "unknown"}}},
        {"properties": {"knowledge_cutoff": {"type": "string", "format": "date-time"}, "bucket": {"enum": ["pre_cutoff", "post_cutoff"]}}}
      ]
    },
    "contest": {
      "type": "object", "additionalProperties": false,
      "required": ["split", "source_family_id", "published_at", "source", "case_ids", "contamination"],
      "properties": {
        "split": {"$ref": "#/$defs/split"},
        "source_family_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "published_at": {"type": "string", "format": "date-time"},
        "source": {"$ref": "#/$defs/source"},
        "case_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
        "contamination": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/contamination"}}
      }
    }
  }
}

