{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.local/schemas/provider-profile-v1.json",
  "title": "Harness provider profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "profile_id", "profile_version", "status", "adapter",
    "provider", "model", "sdk", "capabilities", "knowledge_cutoff",
    "pricing", "credential_owner", "paid_call_ceiling", "approval",
    "execution", "network_ready"
  ],
  "properties": {
    "schema_version": {"const": "provider-profile-v1"},
    "profile_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
    "profile_version": {"type": "integer", "minimum": 1},
    "status": {"enum": ["Proposed", "Accepted", "Retired"]},
    "adapter": {"const": "openai-responses-official-async"},
    "provider": {"const": "openai"},
    "model": {
      "type": "object", "additionalProperties": false,
      "required": ["requested_snapshot", "floating_alias_forbidden", "identity_evidence"],
      "properties": {
        "requested_snapshot": {"type": ["string", "null"], "minLength": 1},
        "floating_alias_forbidden": {"const": true},
        "identity_evidence": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "sdk": {
      "type": "object", "additionalProperties": false,
      "required": ["package", "exact_version", "official_evidence"],
      "properties": {
        "package": {"const": "openai"},
        "exact_version": {"type": ["string", "null"], "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+.*$"},
        "official_evidence": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "capabilities": {
      "type": "object", "additionalProperties": false,
      "required": ["context_limit", "context_limit_evidence", "structured_outputs", "custom_functions", "non_streaming", "capability_evidence"],
      "properties": {
        "context_limit": {"type": ["integer", "null"], "minimum": 1},
        "context_limit_evidence": {"type": ["string", "null"], "minLength": 1},
        "structured_outputs": {"type": ["boolean", "null"]},
        "custom_functions": {"type": ["boolean", "null"]},
        "non_streaming": {"const": true},
        "capability_evidence": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "knowledge_cutoff": {
      "type": "object", "additionalProperties": false,
      "required": ["value", "evidence", "verified_at"],
      "properties": {
        "value": {"type": ["string", "null"], "minLength": 1},
        "evidence": {"type": ["string", "null"], "minLength": 1},
        "verified_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "pricing": {
      "type": "object", "additionalProperties": false,
      "required": ["currency", "version", "source", "verified_at"],
      "properties": {
        "currency": {"type": ["string", "null"], "pattern": "^[A-Z]{3}$"},
        "version": {"type": ["string", "null"], "minLength": 1},
        "source": {"type": ["string", "null"], "minLength": 1},
        "verified_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "credential_owner": {"type": ["string", "null"], "minLength": 1},
    "paid_call_ceiling": {
      "type": "object", "additionalProperties": false,
      "required": ["max_calls", "max_cost", "currency"],
      "properties": {
        "max_calls": {"type": ["integer", "null"], "minimum": 1},
        "max_cost": {"type": ["string", "null"], "pattern": "^[0-9]+(\\.[0-9]+)?$"},
        "currency": {"type": ["string", "null"], "pattern": "^[A-Z]{3}$"}
      }
    },
    "approval": {
      "type": "object", "additionalProperties": false,
      "required": ["approvers", "approved_at", "artifact_digest"],
      "properties": {
        "approvers": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "approved_at": {"type": ["string", "null"], "format": "date-time"},
        "artifact_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "execution": {
      "type": "object", "additionalProperties": false,
      "required": ["api", "async_sdk", "stream", "sdk_max_retries", "project_max_attempts", "automatic_tool_execution", "hosted_tools", "provider_conversation_state"],
      "properties": {
        "api": {"const": "responses"},
        "async_sdk": {"const": true},
        "stream": {"const": false},
        "sdk_max_retries": {"const": 0},
        "project_max_attempts": {"const": 1},
        "automatic_tool_execution": {"const": false},
        "hosted_tools": {"const": false},
        "provider_conversation_state": {"const": false}
      }
    },
    "network_ready": {"type": "boolean"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "Accepted"}}, "required": ["status"]},
      "then": {
        "properties": {
          "network_ready": {"const": true},
          "model": {"properties": {"requested_snapshot": {"type": "string"}, "identity_evidence": {"type": "string"}}},
          "sdk": {"properties": {"exact_version": {"type": "string"}, "official_evidence": {"type": "string"}}},
          "capabilities": {"properties": {"context_limit": {"type": "integer"}, "context_limit_evidence": {"type": "string"}, "structured_outputs": {"type": "boolean"}, "custom_functions": {"type": "boolean"}, "capability_evidence": {"type": "string"}}},
          "knowledge_cutoff": {"properties": {"value": {"type": "string"}, "evidence": {"type": "string"}, "verified_at": {"type": "string"}}},
          "pricing": {"properties": {"currency": {"type": "string"}, "version": {"type": "string"}, "source": {"type": "string"}, "verified_at": {"type": "string"}}},
          "credential_owner": {"type": "string"},
          "paid_call_ceiling": {"properties": {"max_calls": {"type": "integer"}, "max_cost": {"type": "string"}, "currency": {"type": "string"}}},
          "approval": {"properties": {"approvers": {"minItems": 2}, "approved_at": {"type": "string"}, "artifact_digest": {"type": "string"}}}
        }
      }
    },
    {
      "if": {"properties": {"network_ready": {"const": true}}, "required": ["network_ready"]},
      "then": {"properties": {"status": {"const": "Accepted"}}}
    }
  ]
}

