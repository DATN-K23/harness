{
  "name": "@audit-harness/root",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "deps:check": "depcruise --config dependency-cruiser.config.mjs --output-type err .",
    "check": "corepack pnpm run format:check && corepack pnpm run lint && corepack pnpm run typecheck && corepack pnpm run deps:check",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e:slice1": "vitest run --config vitest.e2e.config.ts",
    "verify": "corepack pnpm run check && corepack pnpm run test && corepack pnpm run test:e2e:slice1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "dependency-cruiser": "18.1.0",
    "eslint": "10.8.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
