{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "harness",
  "description": "Smart-contract Judge agent loop workspace",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "typecheck": "bun turbo typecheck",
    "test": "bun turbo test",
    "demo": "bun run --cwd packages/core demo",
    "cli:run": "bun run --cwd packages/cli dev -- run",
    "cli:view": "bun run --cwd packages/cli dev -- view",
    "db:migrate": "bun run --cwd packages/schema db:migrate",
    "cli:repo": "bun run --cwd packages/cli dev -- repo",
    "cli:snapshot": "bun run --cwd packages/cli dev -- snapshot"
  },
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "@tsconfig/bun": "1.0.9",
      "@types/bun": "1.3.13",
      "typescript": "5.8.2",
      "zod": "4.1.8"
    }
  },
  "devDependencies": {
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "turbo": "2.10.2",
    "typescript": "catalog:"
  },
  "license": "MIT",
  "prettier": {
    "semi": false,
    "printWidth": 120
  }
}
